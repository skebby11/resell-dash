# Copia questo file in .env.local e valorizza le variabili necessarie.
# Nessun valore reale è presente in questo file.

# --- Supabase ---------------------------------------------------------
# URL e anon key del progetto Supabase (esposte al browser: NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: SOLO lato server, non esporre mai al client.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ----------------------------------------------------------------
# Chiave API Anthropic (Claude), per automazioni/agenti AI.
ANTHROPIC_API_KEY=
# Chiave API Groq (inferenza LLM veloce/economica), uso alternativo/parallelo.
GROQ_API_KEY=

# --- Barcode lookup ------------------------------------------------------
# UPCitemdb: riconoscimento prodotto da codice a barre.
UPCITEMDB_API_KEY=

# --- IGDB / Twitch -------------------------------------------------------
# IGDB usa le credenziali applicazione Twitch per l'autenticazione OAuth.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
