# Copia questo file in .env.local e valorizza le variabili necessarie.
# Nessun valore reale è presente in questo file.

# --- Supabase (obbligatorie) -------------------------------------------
# URL del progetto e publishable key (`sb_publishable_…`, oppure la legacy anon
# key). Esposte al browser: qualsiasi NEXT_PUBLIC_* finisce nel bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret / service role key: bypassa le RLS, quindi SOLO lato server e mai in una
# variabile NEXT_PUBLIC_. Serve a `npm run seed` e agli script amministrativi.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ----------------------------------------------------------------
# Origin pubblico dell'app, usato per costruire il link di ritorno del magic
# link. In locale si può omettere: viene ricavato dagli header della richiesta.
# In produzione impostalo (es. https://rewind.example.com) e aggiungi
# `<origin>/auth/confirm` fra i Redirect URL su Supabase.
NEXT_PUBLIC_SITE_URL=

# --- AI ----------------------------------------------------------------
# Chiave API Anthropic (Claude), per automazioni/agenti AI.
ANTHROPIC_API_KEY=
# Chiave API Groq (inferenza LLM veloce/economica), uso alternativo/parallelo.
GROQ_API_KEY=

# --- IGDB / Twitch (barcode lookup, passo 2) -----------------------------
# Il barcode risolve sempre dal catalogo interno senza chiavi (vedi README,
# sezione "Barcode lookup"). Queste due servono solo per il passo 2: quando
# un barcode è sconosciuto, l'utente cerca il titolo su IGDB e lo sceglie da
# una lista, per collegarlo al prodotto. IGDB usa le credenziali applicazione
# Twitch per l'autenticazione OAuth (vedi README per come registrarle su
# dev.twitch.tv). Senza queste due, quel passo è assente (niente errore
# 500): resta solo la compilazione manuale.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
